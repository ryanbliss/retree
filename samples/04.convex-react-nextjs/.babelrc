{
    "presets": ["next/babel"],
    "plugins": [
        [
            "@retreejs/babel-plugin-compiler",
            {
                "bases": ["ConvexNode", "BaseConvexNode"]
            }
        ],
        [
            "@babel/plugin-proposal-decorators",
            {
                "version": "2023-11"
            }
        ]
    ]
}
