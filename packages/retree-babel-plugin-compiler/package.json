{
    "name": "@retreejs/babel-plugin-compiler",
    "version": "0.0.0",
    "description": "Babel plugin that compiles ReactiveNode classes into proxy-free managed classes.",
    "author": "Ryan Bliss",
    "private": false,
    "type": "module",
    "license": "MIT",
    "main": "./bin/index.js",
    "types": "./bin/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "prepack": "node ../../scripts/sync-package-docs.mjs ."
    },
    "dependencies": {
        "@babel/parser": "^7.27.0",
        "@babel/types": "^7.27.0"
    },
    "devDependencies": {
        "@babel/core": "^7.27.0",
        "@babel/plugin-proposal-decorators": "^7.29.0",
        "@babel/plugin-syntax-decorators": "^7.27.0",
        "@babel/preset-typescript": "^7.27.0",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^22.10.0",
        "typescript": "^6.0.2"
    },
    "peerDependencies": {
        "@babel/core": "^7.0.0",
        "@retreejs/core": "0.10.4"
    },
    "repository": {
        "directory": "packages/retree-babel-plugin-compiler",
        "type": "git",
        "url": "git+https://github.com/ryanbliss/retree.git"
    },
    "homepage": "https://www.retree.dev",
    "bugs": {
        "url": "https://github.com/ryanbliss/retree/issues"
    },
    "exports": {
        ".": {
            "types": "./bin/index.d.ts",
            "default": "./bin/index.js"
        }
    },
    "files": [
        "bin",
        "README.md",
        "llms.txt"
    ],
    "sideEffects": false
}
